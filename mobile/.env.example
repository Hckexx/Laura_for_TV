# =========================================================
# LauraTV Mobile Public Environment Configuration
# =========================================================
#
# Copy this file to mobile/.env for local development.
#
# IMPORTANT:
# Every EXPO_PUBLIC_* value is bundled into the Android app
# and must therefore be treated as public.
#
# NEVER place:
# - Supabase service-role keys
# - passwords
# - private API keys
# - signing credentials
# - admin credentials
#
# in this file.
# =========================================================

EXPO_PUBLIC_API_BASE_URL=https://ibrax-server.onrender.com/api/v1

EXPO_PUBLIC_COWATCH_URL=https://laura-tv-copy-production.up.railway.app

EXPO_PUBLIC_COWATCH_PUBLIC_URL=https://watch.theunfilteredgoose.in


# =========================================================
# LauraTV Android Release Checker
# =========================================================
#
# Use your Supabase PROJECT URL and PUBLIC anon/publishable
# key only.
#
# These values are intentionally public client credentials.
# RLS prevents the Android app from modifying release data.
# =========================================================

EXPO_PUBLIC_RELEASES_SUPABASE_URL=https://YOUR_PROJECT.supabase.co

EXPO_PUBLIC_RELEASES_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_OR_PUBLISHABLE_KEY